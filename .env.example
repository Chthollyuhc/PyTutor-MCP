# ==============================================================================
# PYTUTOR-MCP: HỆ THỐNG GIA SƯ THÔNG MINH (ITS) HỖ TRỢ HỌC LẬP TRÌNH PYTHON
# Cấu hình biến môi trường mẫu (Environment Configuration)
# ==============================================================================

# 1. Google Gemini AI API Key (Khuyên dùng để có trải nghiệm sư phạm tốt nhất)
# Nhận API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Tên mô hình Gemini mặc định (Hạn mức RPD cao, tốc độ sinh phản hồi siêu tốc)
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Cấu hình máy chủ Qwen cục bộ (Dự phòng cho máy chủ trường NEU)
QWEN_API_URL=http://101.96.66.232:8037/ollama/api/generate
QWEN_SECKEY=neutv
QWEN_MODEL=qwen2.5:14b-instruct-ctx16k

# 4. Bảo mật JSON Web Token (JWT)
JWT_SECRET_KEY=pytutor-scaffolding-jwt-secret-2026

# Ghi chú:
# - Nếu không cung cấp GEMINI_API_KEY và máy chủ Qwen không khả dụng, hệ thống sẽ
#   tự động kích hoạt "Pedagogical-Rule-Engine (Offline Fallback)" để sinh gợi ý Socratic
#   chuẩn xác 100% mà không bao giờ gặp lỗi HTTP 500 hay ngắt quãng trải nghiệm!
